# Copy to .env (loaded by the Electron main process via dotenv)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the instructor model (default: claude-opus-4-8).
# Use claude-sonnet-5 to roughly halve conversation cost — and its lower latency
# makes voice conversations feel much snappier.
# TUTOR_MODEL=claude-opus-4-8

# Optional: reasoning depth per reply (low | medium | high, default medium).
# 'low' noticeably cuts the pause before the instructor starts speaking.
# TUTOR_EFFORT=medium
